module FindAI
  module Models
    type search_create_response =
      { poll: FindAI::Models::SearchCreateResponse::Poll }

    class SearchCreateResponse < FindAI::Internal::Type::BaseModel
      attr_accessor poll: FindAI::Models::SearchCreateResponse::Poll

      def initialize: (poll: FindAI::Models::SearchCreateResponse::Poll) -> void

      type poll = { token: String, path: String }

      class Poll < FindAI::Internal::Type::BaseModel
